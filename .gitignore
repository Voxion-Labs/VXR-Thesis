# VXR-Thesis .gitignore

# Binaries and compiled objects
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.obj
/vxr-server
/bin/

# Go artifacts
*.out
vendor/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# C++ / CMake build outputs
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake
*.wasm
!/web/static/wasm/vxr_kernel.wasm
!/web/static/wasm/.gitkeep

# Data and telemetry
/benchmarks/data/*
!/benchmarks/data/.gitkeep

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
